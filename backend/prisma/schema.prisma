datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  dietaryGoals String?
  allergies    UserAllergy[]
  scans        ScanHistory[]
  favorites    Favorite[]
  usageLogs    ScanUsageLog[]
  feedback     ScanFeedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAllergy {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen  String
  createdAt DateTime @default(now())
}

model ScanHistory {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanType           String
  barcode            String?
  imageUrl           String?
  productName        String
  brandName          String?
  calories           Float?
  proteins           Float?
  carbs              Float?
  fats               Float?
  sugar              Float?
  sodium             Float?
  saturatedFat       Float?
  nutritionScore     String?
  rawOcrText         String?
  ingredients        String?
  detectedAllergens  String?
  additives          String?
  qualityAnalysis    String?
  confidenceScore    Float?
  favorites          Favorite[]
  feedback           ScanFeedback[]
  createdAt          DateTime   @default(now())
}

model Favorite {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId    String
  scan       ScanHistory @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  @@unique([userId, scanId])
}

model FoodMasterItem {
  id             String   @id @default(uuid())
  category       String
  name           String   @unique
  brandName      String?
  barcode        String?
  keywords       String
  portion        String
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float?
  sugar          Float?
  sodium         Float?
  saturatedFat   Float?
  truthScore     Float
  novaLevel      Int
  ratingCategory String
  healthySwaps   String?
  ingredients    String?
  allergens      String?
  healthSummary  String?
  createdAt      DateTime @default(now())
}

model ScanUsageLog {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanType         String
  status           String
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd  Float?
  imageBytes       Int?
  processingTimeMs Int?
  cacheHit         Boolean  @default(false)
  errorCode        String?
  createdAt        DateTime @default(now())
  @@index([userId, createdAt])
  @@index([scanType, createdAt])
  @@index([status, createdAt])
  @@index([model, createdAt])
}

model ScanFeedback {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId         String
  scan            ScanHistory @relation(fields: [scanId], references: [id], onDelete: Cascade)
  feedbackType   String
  correctedName  String?
  correctedBrand String?
  comment        String?
  reviewStatus   String      @default("PENDING")
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  @@index([userId, createdAt])
  @@index([scanId, createdAt])
  @@index([feedbackType, createdAt])
  @@index([reviewStatus, createdAt])
}
