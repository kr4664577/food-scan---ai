datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  dietaryGoals String?       // e.g. "Low Sodium, High Protein"
  allergies    UserAllergy[]
  scans        ScanHistory[]
  favorites    Favorite[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAllergy {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen  String   // e.g. "Peanuts", "Gluten", "Dairy", "Soy"
  createdAt DateTime @default(now())
}

model ScanHistory {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanType           String     // "PACKAGED", "MEAL", "QUALITY_INSPECTION"
  barcode            String?
  imageUrl           String?
  productName        String
  brandName          String?
  calories           Float?
  proteins           Float?
  carbs              Float?
  fats               Float?
  sugar              Float?
  sodium             Float?
  saturatedFat       Float?
  nutritionScore     String?    // e.g., "A", "B", "C", "D", "E" or "88/100"
  rawOcrText         String?
  ingredients        String?    // JSON string array
  detectedAllergens  String?    // JSON string array
  additives          String?    // JSON string array of additive objects
  qualityAnalysis    String?    // JSON string object
  confidenceScore    Float?     // e.g., 0.95
  favorites          Favorite[]
  createdAt          DateTime   @default(now())
}

model Favorite {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId    String
  scan      ScanHistory @relation(fields: [scanId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, scanId])
}

model FoodMasterItem {
  id             String   @id @default(uuid())
  category       String   // "HOME_FOOD", "RESTAURANT_FOOD", "OUTSIDE_PACKAGED", "FRUITS", "VEGETABLES"
  name           String   @unique
  brandName      String?
  barcode        String?
  keywords       String   // comma-separated search terms
  portion        String
  calories       Float
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float?
  sugar          Float?
  sodium         Float?
  saturatedFat   Float?
  truthScore     Float    // 0.0 to 5.0
  novaLevel      Int      // 1, 2, 3, 4
  ratingCategory String   // "GOOD", "MODERATE", "BAD"
  healthySwaps   String?  // JSON string of recommended healthier options
  ingredients    String?  // JSON string array
  allergens      String?  // JSON string array
  healthSummary  String?
  createdAt      DateTime @default(now())
}
