{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    }
  ]
}
